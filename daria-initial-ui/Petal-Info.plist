<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The system authentication dialog uses the bundle name, not just the home-screen display name. -->
	<key>CFBundleName</key>
	<string>Sync</string>
	<!-- Google Sign-In redirects back to the app through this URL scheme (REVERSED_CLIENT_ID). -->
	<!-- petal:// opens screens from the home screen widget, e.g. petal://log. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.257083287916-pq9q74b4msae7hjm1lh8r5jh1433l0dh</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hackathon.petal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>petal</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
